{
  "name": "game-motivation-messages",
  "version": "1.0.0",
  "description": "Display random motivation messages themed around video games",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.gamemotivation.app",
    "productName": "Game Motivation Messages",
    "files": [
      "main.js",
      "index.html",
      "src/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
